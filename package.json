{
  "name": "fincompare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "build:api": "node scripts/build-api.mjs",
    "build:deploy": "pnpm run build:api && pnpm --filter @fincompare/web build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@libsql/client": "^0.17.4"
  }
}
