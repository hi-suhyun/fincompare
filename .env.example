# ─── 국내 재무제표 ───────────────────────────────────────────────
# https://opendart.fss.or.kr/ → 인증키 신청/관리 (40자리, 무료·즉시 발급)
DART_API_KEY=

# ─── 미국 재무제표 ───────────────────────────────────────────────
# SEC 는 API 키가 없지만 User-Agent 헤더가 필수다. 없으면 403 이 떨어진다.
# 형식: "{앱이름} {연락처 이메일}"
SEC_USER_AGENT="FinCompare your-email@example.com"

# ─── 국내 주가 ───────────────────────────────────────────────────
# https://openapi.krx.co.kr/ → 회원가입 → MyPage 인증키 신청
#
# ⚠️ 인증키 승인과 API 이용신청은 **별개 절차**다. 키만 승인받으면 모든 호출이 401 이다.
#    「서비스 이용 > 주식」 페이지에서 아래 두 서비스에 각각 「API 이용신청」을 눌러야 하고,
#    마이페이지 > 이용현황 에서 상태가 "승인"으로 바뀌어야 동작한다.
#      - 유가증권 일별매매정보 (KOSPI)
#      - 코스닥 일별매매정보 (KOSDAQ)
KRX_AUTH_KEY=

# ─── 미국 주가 ───────────────────────────────────────────────────
# https://www.tiingo.com/ 무료 가입 (1,000 req/일, 30년+ 히스토리)
# ⚠️ 무료 티어는 "Internal Use Only" — 공개 배포 시 Power 플랜 필요
TIINGO_API_KEY=

# ─── 어댑터 선택 ─────────────────────────────────────────────────
# krx: 공식 API (권장) / naver: 비공식 폴백, KRX 키 승인 전 개발용
PRICE_PROVIDER_KR=krx
PRICE_PROVIDER_US=tiingo

# 환율(Frankfurter/ECB)은 키가 필요 없다.

# ─── 인프라 ──────────────────────────────────────────────────────
DATABASE_URL=file:./data/dev.db
PORT=3100
VITE_API_BASE_URL=http://localhost:3100
