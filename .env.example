# 재무지표 비교 — 설정
#
# 이 파일을 .env 로 복사한 뒤 키를 채우세요.
#   cp .env.example .env
#
# 또는 ./setup.sh 를 실행하면 하나씩 물어보며 만들어 줍니다.
#
# 이 도구는 본인 컴퓨터에서만 돕니다. 키는 이 파일 밖으로 나가지 않고,
# 받아온 데이터도 본인 컴퓨터의 SQLite 파일에만 쌓입니다.

# ─── 국내 재무제표 (필수) ────────────────────────────────────────
# https://opendart.fss.or.kr/ → 인증키 신청/관리 (40자리, 무료·즉시 발급)
DART_API_KEY=

# ─── 미국 재무제표 (필수) ────────────────────────────────────────
# SEC 는 API 키가 없지만 User-Agent 헤더가 필수다. 없으면 403 이 떨어진다.
# 형식: "{앱이름} {연락처 이메일}" — 이메일은 본인 것을 넣으세요.
SEC_USER_AGENT="FinCompare your-email@example.com"

# ─── 국내 주가 (권장) ────────────────────────────────────────────
# https://openapi.krx.co.kr/ → 회원가입 → MyPage 인증키 신청
#
# 없으면 국내 PER·PBR·주가가 "데이터 없음"이 된다. 재무지표는 정상 동작한다.
#
# ⚠️ 인증키 승인과 API 이용신청은 **별개 절차**다. 키만 승인받으면 모든 호출이 401 이다.
#    「서비스 이용 > 주식」 페이지에서 아래 두 서비스에 각각 「API 이용신청」을 눌러야 하고,
#    마이페이지 > 이용현황 에서 상태가 "승인"으로 바뀌어야 동작한다.
#      - 유가증권 일별매매정보 (KOSPI)
#      - 코스닥 일별매매정보 (KOSDAQ)
KRX_AUTH_KEY=

# ─── 미국 주가 (선택) ────────────────────────────────────────────
# https://www.tiingo.com/ → 무료 가입 → API Token
#
# 없으면 미국 PER·PBR·주가가 "데이터 없음"이 된다. 재무지표는 정상 동작한다.
#
# 무료 티어는 "받은 데이터를 남에게 보여주거나 공유하지 말 것"을 요구한다.
# 본인 키로 본인 컴퓨터에서 보는 건 여기에 해당하지 않는다 — 제공처에서
# 본인에게 직접 간 본인 데이터다. 다만 이 화면을 남에게 서비스하지는 말 것.
TIINGO_API_KEY=

# ─── 애널리스트 컨센서스 (선택) ──────────────────────────────────
# https://site.financialmodelingprep.com/ → 무료 가입 → API Key
#
# 없으면 추정치 밴드가 꺼진다. 나머지는 그대로 동작한다.
#
# 무료 티어에서 되는 것 (2026-08 확인):
#   analyst-estimates       ✅ 10년치 연간 EPS·매출 추정 — 밴드의 핵심
#   price-target-consensus  ✅ 현재 목표주가 한 건
#   price-target-news       ❌ 발행일 붙은 개별 목표가는 유료
#
# 하루 250 콜. 기업당 1회면 되고 3일간 캐싱한다.
# Tiingo 와 같은 이유로 본인 화면에서만 쓴다.
FMP_API_KEY=

# ─── 어댑터 선택 ─────────────────────────────────────────────────
# krx: 공식 API (권장) / naver: 비공식 폴백, KRX 키 승인 전 개발용
PRICE_PROVIDER_KR=krx
PRICE_PROVIDER_US=tiingo

# 환율(Frankfurter/ECB)은 키가 필요 없다.

# ─── 실행 설정 ───────────────────────────────────────────────────
# 받아온 데이터가 쌓이는 SQLite 파일. 지우면 처음부터 다시 받는다.
DATABASE_URL=file:./data/dev.db
PORT=3100
VITE_API_BASE_URL=http://localhost:3100

# 접근 비밀번호. 로컬 전용이라 보통은 비워 둔다.
# 집 네트워크의 다른 기기에서 열어 볼 때처럼 굳이 막고 싶으면 채운다.
ACCESS_PASSWORD=
