# ─── 국내 재무제표 ───────────────────────────────────────────────
# https://opendart.fss.or.kr/ → 인증키 신청/관리 (40자리, 무료·즉시 발급)
DART_API_KEY=

# ─── 미국 재무제표 ───────────────────────────────────────────────
# SEC 는 API 키가 없지만 User-Agent 헤더가 필수다. 없으면 403 이 떨어진다.
# 형식: "{앱이름} {연락처 이메일}"
SEC_USER_AGENT="FinCompare your-email@example.com"

# ─── 국내 주가 ───────────────────────────────────────────────────
# https://openapi.krx.co.kr/ → 회원가입 → MyPage 인증키 신청
#
# ⚠️ 인증키 승인과 API 이용신청은 **별개 절차**다. 키만 승인받으면 모든 호출이 401 이다.
#    「서비스 이용 > 주식」 페이지에서 아래 두 서비스에 각각 「API 이용신청」을 눌러야 하고,
#    마이페이지 > 이용현황 에서 상태가 "승인"으로 바뀌어야 동작한다.
#      - 유가증권 일별매매정보 (KOSPI)
#      - 코스닥 일별매매정보 (KOSDAQ)
KRX_AUTH_KEY=

# ─── 미국 주가 (선택 — 본인이 직접 쓸 때만) ─────────────────────
# https://www.tiingo.com/ → 무료 가입 → API Token
#
# 비워두면 미국 기업의 PER/PBR 이 "데이터 없음"으로 표시된다. 재무지표는 정상 동작한다.
#
# ⚠️ 무료 주가 API 는 예외 없이 재배포·표시를 금지한다.
#    Tiingo 무료 티어 약관: "you may not display or share the data with
#    another person or organization"
#
#    금지되는 것: 내 키로 띄운 서버의 링크를 남에게 주고 그 사람이 미국 PER 을 보는 것.
#    괜찮은 것:   각자 자기 키를 넣고 자기 인스턴스에서 보는 것.
#                 데이터가 제공처에서 그 사람에게 직접 가므로 재배포가 아니다.
#
#    그래서 여러 명이 쓰는 배포판은 이 값을 비워 둔다.
#    혼자 쓰거나 셀프호스트라면 채워도 된다. 자세한 근거는 docs/00-data-sources.md 3.4.
TIINGO_API_KEY=

# ─── 어댑터 선택 ─────────────────────────────────────────────────
# krx: 공식 API (권장) / naver: 비공식 폴백, KRX 키 승인 전 개발용
PRICE_PROVIDER_KR=krx
PRICE_PROVIDER_US=tiingo

# 환율(Frankfurter/ECB)은 키가 필요 없다.

# ─── 인프라 ──────────────────────────────────────────────────────
# 로컬은 파일, 배포는 libsql:// 원격 (Turso)
DATABASE_URL=file:./data/dev.db
# 원격 DB 를 쓸 때만 필요하다
TURSO_AUTH_TOKEN=
PORT=3100

# 가족 전용 접근 비밀번호.
# 비워두면 게이트를 걸지 않는다 (로컬 개발). 배포에서는 반드시 채운다 —
# URL 이 알려지면 모르는 사람이 DART 일일 호출 한도를 태운다.
ACCESS_PASSWORD=
VITE_API_BASE_URL=http://localhost:3100
