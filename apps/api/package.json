{
  "name": "@fincompare/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify:dart": "tsx src/scripts/verifyDart.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:us": "tsx src/scripts/seedUs.ts"
  },
  "dependencies": {
    "@fincompare/shared": "workspace:*",
    "@libsql/client": "^0.17.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.6",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
